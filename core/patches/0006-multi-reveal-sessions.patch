index 0000000..442a8f6
--- /dev/null
+++ b/crates/sdk-core/tests/multi_reveal.rs
@@ -0,0 +1,180 @@
+//! Several proofs on one session.
+//!
+//! A native Proxy-mode session against the upstream TLS fixture (in-memory duplexes): the prover proves several
+//! disclosures of ONE transcript with `reveal_open`, the verifier verifies each with `verify_open`, and both close.
+
+use std::{ops::Range, time::Duration};
+
+use tlsn_sdk_core::{
+    HttpRequest, ProverConfig, ProverMode, Reveal, SdkProver, SdkVerifier, VerifierConfig, VerifierOutput,
+};
+use tlsn_server_fixture::bind;
+use tlsn_server_fixture_certs::{CA_CERT_DER, SERVER_DOMAIN};
+use tokio_util::compat::TokioAsyncReadCompatExt;
+
+const BODY: usize = 4096;
+const LIMIT: Duration = Duration::from_secs(120);
+
+/// A prover with the fixture's response in its transcript and a verifier that has run the TLS session, both
+/// committed and ready to prove / verify.
+async fn committed() -> (SdkProver, SdkVerifier, usize) {
+    let (p_io, v_io) = tokio::io::duplex(1 << 23);
+    let (client_io, server_io) = tokio::io::duplex(1 << 20);
+    tokio::spawn(async move {
+        let _ = bind(server_io.compat()).await;
+    });
+
+    let mut prover = SdkProver::new(
+        ProverConfig::builder(SERVER_DOMAIN)
+            .mode(ProverMode::Proxy)
+            .root_certs(vec![CA_CERT_DER.to_vec()])
+            .build()
+            .unwrap(),
+    )
+    .unwrap();
+    let mut verifier = SdkVerifier::new(
+        VerifierConfig::builder()
+            .max_sent_data(4096)
+            .max_recv_data(1 << 16)
+            .root_certs(vec![CA_CERT_DER.to_vec()])
+            .build()
+            .unwrap(),
+    );
+
+    let prove = async {
+        prover.setup(p_io.compat()).await.unwrap();
+        let request = HttpRequest::get(format!("/bytes?size={BODY}"))
+            .header("Host", SERVER_DOMAIN)
+            .header("Connection", "close");
+        let response = prover.send_request_proxy(request).await.unwrap();
+        assert_eq!(response.status, 200);
+    };
+    let verify = async {
+        verifier.connect(v_io.compat()).await.unwrap();
+        let server = verifier.setup().await.unwrap();
+        assert_eq!(server.as_deref(), Some(SERVER_DOMAIN));
+        verifier.set_server_socket(client_io.compat()).unwrap();
+        verifier.run().await.unwrap();
+    };
+    tokio::time::timeout(LIMIT, async { tokio::join!(prove, verify) })
+        .await
+        .expect("session setup stalled");
+    let recv_len = prover.transcript().unwrap().recv.len();
+    assert!(recv_len > BODY);
+    (prover, verifier, recv_len)
+}
+
+/// One proof on each side at once.
+async fn prove_once(
+    prover: &mut SdkProver,
+    verifier: &mut SdkVerifier,
+    reveal: Reveal,
+) -> VerifierOutput {
+    let (p, v) = tokio::time::timeout(LIMIT, async {
+        tokio::join!(prover.reveal_open(reveal, None), verifier.verify_open())
+    })
+    .await
+    .expect("proof stalled");
+    p.unwrap();
+    v.unwrap()
+}
+
+fn recv_authed(output: &VerifierOutput) -> Vec<Range<usize>> {
+    output.transcript.as_ref().unwrap().recv_authed.clone()
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn several_reveals_give_one_output_each_then_close() {
+    let (mut prover, mut verifier, recv_len) = committed().await;
+    let sets: Vec<Vec<Range<usize>>> = vec![
+        vec![0..15, 200..264],
+        vec![1000..1040, 1100..1110],
+        // An AES block an earlier proof already revealed (1000..1040 shares 1024..1040).
+        vec![1030..1060],
+        vec![recv_len - 32..recv_len],
+    ];
+    for (i, set) in sets.iter().enumerate() {
+        let mut reveal = Reveal::new().server_identity(i == 0);
+        if i == 0 {
+            reveal = reveal.sent(0..10);
+        }
+        for r in set {
+            reveal = reveal.recv(r.clone());
+        }
+        let out = prove_once(&mut prover, &mut verifier, reveal).await;
+        // Each output is that proof's disclosure only.
+        assert_eq!(recv_authed(&out), *set, "reveal {i}");
+        assert_eq!(out.server_name.as_deref(), (i == 0).then_some(SERVER_DOMAIN), "reveal {i}");
+        let sent = &out.transcript.as_ref().unwrap().sent_authed;
+        assert_eq!(sent, &if i == 0 { vec![0..10] } else { vec![] }, "reveal {i}");
+        assert_eq!(out.connection_info.transcript_length.recv as usize, recv_len);
+        assert!(!prover.is_complete() && !verifier.is_complete());
+    }
+    assert_eq!(prover.reveal_count(), sets.len());
+    assert_eq!(verifier.verified_count(), sets.len());
+
+    let (p, v) = tokio::join!(prover.finish(), verifier.close());
+    p.unwrap();
+    v.unwrap();
+    assert!(prover.is_complete() && verifier.is_complete());
+    // Closed: nothing more on either side.
+    assert!(prover.reveal_open(Reveal::new().recv(0..4), None).await.is_err());
+    assert!(verifier.verify_open().await.is_err());
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn single_reveal_is_unchanged() {
+    let (mut prover, mut verifier, _) = committed().await;
+    let reveal = Reveal::new().server_identity(true).sent(0..10).recv(0..15);
+    let (p, v) = tokio::time::timeout(LIMIT, async {
+        tokio::join!(prover.reveal(reveal, None), verifier.verify())
+    })
+    .await
+    .expect("proof stalled");
+    p.unwrap();
+    let out = v.unwrap();
+    assert_eq!(recv_authed(&out), vec![0..15]);
+    assert_eq!(out.server_name.as_deref(), Some(SERVER_DOMAIN));
+    assert!(prover.is_complete() && verifier.is_complete());
+    assert_eq!(prover.reveal_count(), 1);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn finish_before_any_reveal_is_refused_and_the_session_stays_usable() {
+    let (mut prover, mut verifier, _) = committed().await;
+    let err = prover.finish().await.unwrap_err();
+    assert!(err.to_string().contains("nothing was revealed"), "{err}");
+    // An invalid range is refused before anything is sent; the session stays usable too.
+    assert!(prover.reveal_open(Reveal::new().recv(0..usize::MAX), None).await.is_err());
+    let out = prove_once(&mut prover, &mut verifier, Reveal::new().server_identity(true).recv(0..15)).await;
+    assert_eq!(recv_authed(&out), vec![0..15]);
+    let (p, v) = tokio::join!(prover.finish(), verifier.close());
+    p.unwrap();
+    v.unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_verifier_waiting_for_another_proof_ends_when_the_prover_finishes() {
+    let (mut prover, mut verifier, _) = committed().await;
+    prove_once(&mut prover, &mut verifier, Reveal::new().server_identity(true).recv(0..15)).await;
+    prover.finish().await.unwrap();
+    // The prover closed its session: the waiting verifier fails (no hang) and is closed.
+    let waited = tokio::time::timeout(LIMIT, verifier.verify_open()).await.expect("verifier hung");
+    assert!(waited.is_err());
+    assert!(verifier.close().await.is_err(), "already closed by the failed wait");
+    assert!(!verifier.is_complete());
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_prover_proving_after_the_verifier_closed_fails_and_is_closed() {
+    let (mut prover, mut verifier, _) = committed().await;
+    prove_once(&mut prover, &mut verifier, Reveal::new().server_identity(true).recv(0..15)).await;
+    verifier.close().await.unwrap();
+    let proved = tokio::time::timeout(LIMIT, prover.reveal_open(Reveal::new().recv(20..30), None))
+        .await
+        .expect("prover hung");
+    assert!(proved.is_err());
+    // The failed reveal closed the prover: no finish, no further reveal.
+    assert!(prover.finish().await.is_err());
+    assert!(prover.reveal_open(Reveal::new().recv(20..30), None).await.is_err());
+}
