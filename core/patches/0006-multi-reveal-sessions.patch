+    /// session after one or more `reveal_open` calls.
+    pub async fn finish(&mut self) -> Result<()> {
+        self.inner
+            .finish()
+            .await
+            .map_err(|e| JsError::new(&e.to_string()))?;
+        self.emit_progress("FINALIZED", 0.95, "Protocol finalized");
+        Ok(())
+    }
 }
 
