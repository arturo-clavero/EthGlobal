diff --git a/crates/sdk-core/src/types.rs b/crates/sdk-core/src/types.rs
index 62a55db..512dade 100644
--- a/crates/sdk-core/src/types.rs
+++ b/crates/sdk-core/src/types.rs
@@ -435,6 +435,21 @@ pub struct HandlerParams {
     /// Regex flags (for `All` part with `type: "regex"`).
     #[serde(skip_serializing_if = "Option::is_none")]
     pub flags: Option<String>,
+    /// Match window (for `All` part with `type: "regex"`): keep only the
+    /// matches with index `skip..skip + take` (0-based, in document order), so a large response's
+    /// repeated entries can be revealed one window at a time. `None` keeps every match.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub window: Option<MatchWindow>,
+}
+
+/// A window over a regex handler's matches (see [`HandlerParams::window`]).
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct MatchWindow {
+    /// Matches to skip, counted from the first match in the transcript part.
+    pub skip: usize,
+    /// Matches to keep after the skipped ones (fewer when the transcript has fewer).
+    pub take: usize,
 }
 
 /// A handler that specifies what data to extract from an HTTP transcript.
